{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path aliases — mirror vite.config.ts resolve.alias.
       Paths are relative to this tsconfig's directory (frontend/),
       so ../engine resolves to engine/ at the repo root. */
    "paths": {
      "@engine": ["../engine/index.ts"],
      "@engine/*": ["../engine/*"],
      "@apps/*": ["../apps/*"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["../engine", "../apps"],
  "exclude": [
    "../engine/**/__tests__/**",
    "../engine/**/*.test.ts",
    "../apps/**/__tests__/**",
    "../apps/**/*.test.ts",
    "../apps/**/*.test.tsx"
  ]
}
